{
  "name": "@sitepark/github-js-release-test",
  "version": "1.1.0-SNAPSHOT",
  "description": "Test js releases with github actions",
  "license": "MIT",
  "repository": "https://github.com/sitepark/github-js-release-test",
  "author": "Holger Veltrup <veltrup@sitepark.com> (http://www.sitepark.com)",
  "main": "index.js",
  "scripts": {
    "format:package-json": "echo 'format package.json'",
    "build": "tsc",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "verify": "npm run verify:format",
    "verify:format": "prettier --check \"**/*.{js,json,md}\"",
    "package": "yarn build",
    "publish": "echo 'publish'"
  },
  "files": [
    "./dist"
  ],
  "devDependencies": {
    "@vitest/coverage-v8": "^4.0.17",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.17"
  }
}
